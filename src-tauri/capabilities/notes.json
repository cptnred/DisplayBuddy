{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "notes",
  "description": "Notes window: notes CRUD, settings, hide self, drag title bar",
  "windows": [
    "notes"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-list-notes",
    "allow-save-note",
    "allow-delete-note",
    "allow-save-order",
    "allow-load-settings",
    "allow-save-settings",
    "allow-hide-notes",
    "allow-flush-done",
    "allow-list-reminders",
    "allow-set-reminder",
    "allow-ack-reminder",
    "allow-snooze-reminder",
    "allow-list-shortcuts",
    "allow-pick-shortcuts",
    "allow-add-bookmark",
    "allow-update-shortcut",
    "allow-remove-shortcut",
    "allow-reorder-shortcuts",
    "allow-open-shortcut",
    "allow-shortcut-icon"
  ]
}
