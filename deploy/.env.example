# Copy to .env and fill in:   cp .env.example .env   &&   nano .env
# Only placeholders here – never commit the real .env.

# Your subdomain (DNS A/AAAA record must point to the VPS).
BUDDY_DOMAIN=buddy.example.org

# E-mail for Let's Encrypt (expiry warnings).
ACME_EMAIL=admin@example.org

# Contact for the push services (VAPID "sub"): mailto:… or https://…
BUDDY_VAPID_SUBJECT=mailto:admin@example.org

# Optional: internal Docker network. Only change if 172.30.0.0/24 is already in use.
# CADDY_IP must lie inside BUDDY_SUBNET but outside BUDDY_IP_RANGE.
#BUDDY_SUBNET=172.30.0.0/24
#BUDDY_IP_RANGE=172.30.0.128/25
#CADDY_IP=172.30.0.10

# Optional: log level (debug for troubleshooting).
#RUST_LOG=info,sqlx=warn,tower_http=warn

# Nur Variante B (vorhandener Reverse-Proxy wie Nginx Proxy Manager, siehe README):
# Dann diese Zeilen aktivieren, damit "docker compose" compose.npm.yaml nutzt.
#COMPOSE_FILE=compose.npm.yaml
#PROXY_NETWORK=proxy          # Name des Docker-Netzes des Reverse-Proxys
#PROXY_SUBNET=172.18.0.0/16   # Subnetz dieses Netzes: docker network inspect proxy

# --- Konten (ab Version 0.4, README Abschnitt 9). Alles optional; ohne Eintrag gilt der Standard. ---
# Selbst registrieren am PC: closed (Standard, nur "user add"), invite (mit Einladungscode) oder open.
#BUDDY_REGISTRATION=closed
# Rechenaufgabe gegen Bots (1–32, Standard 22) und Registrierungen pro Tag insgesamt (Standard 200).
#BUDDY_REGISTRATION_POW_BITS=22
#BUDDY_REGISTRATION_DAILY_LIMIT=200
# Kontingente pro Konto; leer = unbegrenzt. Beispiel: 50 MB, 5000 Notizen, 10 Geräte.
#BUDDY_QUOTA_BYTES=52428800
#BUDDY_QUOTA_NOTES=5000
#BUDDY_QUOTA_DEVICES=10
# Ihre Rechtsseiten (nur https://), angezeigt in den Apps; Pflicht, bevor andere sich registrieren.
#BUDDY_IMPRINT_URL=https://example.org/impressum
#BUDDY_PRIVACY_URL=https://example.org/datenschutz
#BUDDY_TERMS_URL=https://example.org/nutzungsbedingungen
#BUDDY_OPERATOR_NAME=example.org

# Optional: native Android-App mit Firebase (README "Optional: native Android-App mit Firebase").
#BUDDY_FCM_SERVICE_ACCOUNT_FILE=/data/fcm-service-account.json
# full (Standard): Titel/Text der Erinnerung; minimal: nur "Erinnerung fällig" (Google sieht keinen Inhalt).
#BUDDY_FCM_PAYLOAD=full
