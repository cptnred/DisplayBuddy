{
  "name": "display-buddy",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/v3-e2e.mjs",
    "test:tz": "TZ=America/New_York vitest run && TZ=Asia/Tokyo vitest run",
    "typecheck": "tsc --noEmit",
    "build:web": "tsc && vite build --config vite.web.config.ts",
    "build:mobile": "tsc && tsc -p mobile && vite build --config vite.mobile.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-http": "2.8.3",
    "@tauri-apps/plugin-notification": "2.8.0",
    "@tiptap/core": "^3.32.3",
    "@tiptap/extension-list": "^3.32.3",
    "@tiptap/extension-text-style": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/react": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "idb": "8.0.4",
    "lottie-web": "^5.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "fake-indexeddb": "6.2.7",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "7.4.1"
  }
}
