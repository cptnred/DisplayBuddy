patches/*/ios/.tauri/
patches/*/android/build/
plugins/*/android/.tauri/
plugins/*/android/build/
plugins/*/target/
# Signing material must never be committed
*.keystore
*.jks
keystore.properties
*.p12
*.p8
*.mobileprovision
google-services.json
GoogleService-Info.plist
