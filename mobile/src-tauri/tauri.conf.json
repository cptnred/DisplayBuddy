{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Display Buddy",
  "mainBinaryName": "display-buddy-mobile",
  "version": "0.3.0",
  "identifier": "de.displaybuddy.mobile",
  "build": {
    "beforeDevCommand": {
      "script": "npx vite --config vite.mobile.config.ts",
      "cwd": "../..",
      "wait": false
    },
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": {
      "script": "npm run build:mobile",
      "cwd": "../.."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Display Buddy",
        "url": "index.html",
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Display Buddy",
    "shortDescription": "Notizen und Erinnerungen von Display Buddy – Erinnerungen auch ohne Internet",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    }
  }
}
